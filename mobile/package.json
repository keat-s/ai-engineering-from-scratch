{
  "name": "ai-engineering-from-scratch-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AI Engineering from Scratch — learn-on-the-go mobile app (iOS + Android) with a free ad-supported tier and a Pro subscription / lifetime unlock.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "content": "node -e \"require('child_process').execSync('python3 ../scripts/build_mobile_content.py',{stdio:'inherit'})\"",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'add eslint config as needed'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-status-bar": "~2.0.0",
    "expo-tracking-transparency": "~5.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-google-mobile-ads": "^14.7.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^8.2.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
